@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <div class="hero-content text-center">
        <h1 class="display-2 fw-bold">Welcome to KindLink</h1>
        <p class="lead">
            Connecting volunteers with meaningful opportunities in their communities.
        </p>

        <a asp-controller="VolunteerPositions" asp-action="Index" class="btn btn-lg button me-2">
            Find Opportunities
        </a>

        <a asp-controller="Organizations" asp-action="Index" class="btn btn-lg btn-outline-light">
            Browse Organizations
        </a>
    </div>
</div>

