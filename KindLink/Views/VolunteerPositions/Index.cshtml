@model IEnumerable<KindLink.Models.VolunteerPosition>

@{
    ViewData["Title"] = "Volunteer Positions";
}

<h1>Volunteer Positions</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Location)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EventDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>

        <th>
            @Html.DisplayNameFor(model => model.Organization.Name)
        </th>

        <th>
            @Html.DisplayNameFor(model => model.Image)
        </th>
        
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EventDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Organization.Name)
            </td>
            
            <td>
                @if (item.Image != null)
                {
                    <img src="~/img/@item.Image" alt="Product Image" style="width:120px; height:120px; object-fit:cover;" class="thumb" />
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.VolunteerPositionId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.VolunteerPositionId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OrganizationId" onclick="return confirmDelete();">Delete</a>            </td>
        </tr>
    }
    </tbody>
</table>